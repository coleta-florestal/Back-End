// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(USER)

  name  String
  password  String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Farm {
  id String @id @default(uuid())
  name String
  address String?

  plots Plot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("farms")
}

model Plot {
  id String @id @default(uuid())
  name String 
  areaHa Float? @map("area_ha")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plots")
}

model SubPlot {
  id String @id @default(uuid())
  number Int
  areaM2 Float? @map("area_m2")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subplots")
}

model Tree {
  id           String   @id @default(uuid())
  number       Int?     
  diameterDapCm  Float    @map("diameter_dap_cm")
  height       Float   
  condition    String?

  createdAt    DateTime @default(now()) @map("created_at")

  @@map("trees")
}